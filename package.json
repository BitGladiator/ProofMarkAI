{
  "name": "proofmark-ai",
  "version": "1.0.0",
  "description": "ProofMark AI - Brand governance and draft review assistant",
  "main": "backend/app/main.js",
  "type": "module",
  "scripts": {
    "start": "node backend/app/main.js",
    "dev": "node --watch backend/app/main.js",
    "test": "node --test backend/tests/*.test.js",
    "dev:backend": "node --watch backend/app/main.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "test:backend": "node --test backend/tests/*.test.js",
    "test:frontend": "cd frontend && npm test",
    "test:all": "npm run test:backend && npm run test:frontend"
  },
  "keywords": [
    "brand-governance",
    "compliance",
    "ai",
    "review",
    "express",
    "react",
    "typescript"
  ],
  "author": "Karan Sharma",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
