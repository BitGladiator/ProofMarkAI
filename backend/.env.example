# ProofMark AI Backend Environment Configuration

# Application Environment
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Allowed Frontend Origins (comma-separated or JSON array)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Provider Configuration (e.g., openai, gemini, or any OpenAI-compatible provider)
# Leave empty to run in deterministic-only mode without paid API calls
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_BASE_URL=https://api.openai.com/v1

# Operational Limits
MAX_DRAFT_LENGTH=20000
LOG_LEVEL=info
