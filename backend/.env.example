# ProofMark AI Backend Environment Configuration

# Application Environment
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Allowed Frontend Origins (comma-separated or JSON array)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# AI Provider Configuration — Groq Cloud
# Get your free key at https://console.groq.com/keys
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=30

# Operational Limits
MAX_DRAFT_LENGTH=20000
LOG_LEVEL=info
